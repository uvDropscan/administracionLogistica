<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>¿Tienes lo necesario para dirigir una empresa? · Andes Cargo</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #0a0e1a;
    --bg-elev: #121a2b;
    --bg-elev-2: #1a2438;
    --line: #263352;
    --cyan: #00d9c0;
    --amber: #ffb020;
    --violet: #7c5cfc;
    --text: #eef2fa;
    --text-dim: #8b96ac;
    --danger: #ff6b6b;
    --radius: 18px;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html,body{height:100%;}
  body{
    background: radial-gradient(1200px 800px at 50% -10%, #14203a 0%, var(--bg) 55%);
    color: var(--text);
    font-family:'Inter', system-ui, sans-serif;
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    overflow-x:hidden;
    -webkit-font-smoothing:antialiased;
  }
  .app{
    width:100%;
    max-width:480px;
    min-height:100vh;
    position:relative;
    padding: 20px 20px 32px;
    display:flex;
    flex-direction:column;
  }
  @media (min-width:600px){
    body{padding:32px 0;}
    .app{min-height:auto; border-radius:28px; border:1px solid var(--line); box-shadow:0 40px 100px -30px rgba(0,0,0,.7); background: linear-gradient(180deg, var(--bg-elev) 0%, var(--bg) 40%);}
  }
  .screen{ display:none; flex-direction:column; flex:1; animation: rise .5s cubic-bezier(.16,1,.3,1); }
  .screen.active{ display:flex; }
  @keyframes rise{ from{opacity:0; transform:translateY(14px);} to{opacity:1; transform:none;} }
  h1,h2,h3{ font-family:'Space Grotesk', sans-serif; letter-spacing:-.01em; }

  /* --- grid texture bg accent on hero --- */
  .grid-fx{
    position:absolute; inset:0; z-index:0; pointer-events:none; opacity:.35;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 34px 34px;
    -webkit-mask-image: radial-gradient(60% 50% at 50% 20%, #000 0%, transparent 75%);
            mask-image: radial-gradient(60% 50% at 50% 20%, #000 0%, transparent 75%);
  }

  /* eyebrow tag */
  .eyebrow{
    display:inline-flex; align-items:center; gap:8px;
    font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:.12em;
    text-transform:uppercase; color:var(--cyan);
    background: rgba(0,217,192,.08); border:1px solid rgba(0,217,192,.25);
    padding:6px 12px; border-radius:100px; width:fit-content;
  }
  .eyebrow .dot{ width:6px; height:6px; border-radius:50%; background:var(--cyan); box-shadow:0 0 8px var(--cyan); animation: pulse 1.6s infinite; }
  @keyframes pulse{ 0%,100%{opacity:1;} 50%{opacity:.3;} }

  /* ============ HERO ============ */
  #screen-hero{ position:relative; justify-content:center; text-align:left; gap:22px; padding-top:8px; }
  .hero-badge-row{ display:flex; gap:8px; flex-wrap:wrap; }
  .hero-title{ font-size: clamp(30px, 8vw, 40px); line-height:1.08; font-weight:700; }
  .hero-title .accent{ color:var(--amber); }
  .hero-sub{ color:var(--text-dim); font-size:15.5px; line-height:1.55; max-width:40ch; }
  .route-preview{ display:flex; align-items:center; gap:6px; margin-top:4px; }
  .route-preview .seg{ height:3px; flex:1; border-radius:2px; background:var(--line); overflow:hidden;}
  .route-preview .seg i{ display:block; height:100%; width:100%; background: linear-gradient(90deg,var(--cyan),var(--violet)); }
  .hero-stat{ font-family:'JetBrains Mono', monospace; font-size:12px; color:var(--text-dim); }
  .hero-stat b{ color:var(--text); }

  /* ============ BUTTONS ============ */
  .btn{
    border:none; cursor:pointer; font-family:'Space Grotesk', sans-serif; font-weight:600;
    font-size:16px; padding:16px 22px; border-radius:14px; width:100%;
    display:flex; align-items:center; justify-content:center; gap:8px;
    transition: transform .15s ease, filter .15s ease, box-shadow .15s ease;
  }
  .btn:active{ transform: scale(.97); }
  .btn-primary{
    background: linear-gradient(135deg, var(--cyan), #00b3a4);
    color:#001612; box-shadow: 0 10px 30px -8px rgba(0,217,192,.55);
  }
  .btn-primary:hover{ filter:brightness(1.08); }
  .btn-ghost{
    background: transparent; border:1px solid var(--line); color:var(--text);
  }
  .btn-ghost:hover{ border-color:var(--cyan); color:var(--cyan); }
  .btn[disabled]{ opacity:.4; pointer-events:none; }

  /* ============ MISSION ============ */
  #screen-mission{ justify-content:center; gap:18px; }
  .mission-card{
    background: var(--bg-elev); border:1px solid var(--line); border-radius: var(--radius);
    padding:22px; position:relative; overflow:hidden;
  }
  .mission-card::before{
    content:""; position:absolute; top:-40%; right:-30%; width:220px; height:220px; border-radius:50%;
    background: radial-gradient(circle, rgba(124,92,252,.25), transparent 70%);
  }
  .mission-eyebrow{ font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:.12em; color:var(--violet); text-transform:uppercase; margin-bottom:10px; }
  .mission-title{ font-size:23px; font-weight:700; margin-bottom:10px; }
  .mission-body{ color:var(--text-dim); font-size:14.5px; line-height:1.6; }
  .name-field{ margin-top:16px; }
  .name-field label{ font-size:12.5px; color:var(--text-dim); display:block; margin-bottom:6px; }
  .name-field input{
    width:100%; background:var(--bg-elev-2); border:1px solid var(--line); border-radius:10px;
    padding:12px 14px; color:var(--text); font-size:15px; font-family:'Inter',sans-serif;
  }
  .name-field input:focus{ outline:none; border-color:var(--cyan); }
  .meta-row{ display:flex; gap:16px; font-family:'JetBrains Mono', monospace; font-size:11.5px; color:var(--text-dim); margin-top:14px;}
  .meta-row span{ display:flex; align-items:center; gap:5px;}

  /* ============ ROUTE STEPPER (persistent header on decision screens) ============ */
  .stepper-wrap{ margin-bottom:18px; }
  .stepper-top{ display:flex; justify-content:space-between; align-items:baseline; margin-bottom:10px; }
  .stepper-label{ font-family:'JetBrains Mono', monospace; font-size:11px; color:var(--text-dim); text-transform:uppercase; letter-spacing:.08em; }
  .stepper-zeigarnik{ font-size:11.5px; color:var(--amber); font-family:'JetBrains Mono', monospace; }
  .stepper-track{ position:relative; height:34px; }
  .stepper-line-bg{ position:absolute; top:15px; left:14px; right:14px; height:3px; background:var(--line); border-radius:2px; }
  .stepper-line-fill{ position:absolute; top:15px; left:14px; height:3px; background:linear-gradient(90deg,var(--cyan),var(--violet)); border-radius:2px; transition: width .6s cubic-bezier(.16,1,.3,1); }
  .stepper-nodes{ position:absolute; top:0; left:0; right:0; display:flex; justify-content:space-between; }
  .node{
    width:30px; height:30px; border-radius:50%; background:var(--bg-elev); border:2px solid var(--line);
    display:flex; align-items:center; justify-content:center; font-size:12px; font-family:'JetBrains Mono',monospace; color:var(--text-dim);
    transition: all .4s ease; position:relative; z-index:1;
  }
  .node.done{ background:var(--cyan); border-color:var(--cyan); color:#001612; }
  .node.current{ border-color:var(--amber); color:var(--amber); box-shadow:0 0 0 5px rgba(255,176,32,.15); animation: nodePulse 1.4s infinite; }
  @keyframes nodePulse{ 0%,100%{box-shadow:0 0 0 5px rgba(255,176,32,.15);} 50%{box-shadow:0 0 0 9px rgba(255,176,32,.05);} }

  /* ============ DECISION SCREENS ============ */
  .decision-tag{ font-family:'JetBrains Mono', monospace; font-size:11px; color:var(--cyan); text-transform:uppercase; letter-spacing:.1em; margin-bottom:8px;}
  .decision-title{ font-size:20px; font-weight:700; margin-bottom:10px; line-height:1.3;}
  .decision-scenario{ color:var(--text-dim); font-size:14.5px; line-height:1.6; margin-bottom:20px; }
  .options{ display:flex; flex-direction:column; gap:10px; }
  .option{
    text-align:left; background:var(--bg-elev); border:1.5px solid var(--line); border-radius:14px;
    padding:15px 16px; color:var(--text); font-size:14.5px; font-family:'Inter',sans-serif; line-height:1.45;
    cursor:pointer; transition: all .18s ease; display:flex; gap:12px; align-items:flex-start;
  }
  .option .letter{
    font-family:'JetBrains Mono',monospace; font-weight:700; font-size:12px; color:var(--text-dim);
    background:var(--bg-elev-2); width:24px; height:24px; border-radius:7px; display:flex; align-items:center; justify-content:center; flex-shrink:0;
  }
  .option:hover:not([disabled]){ border-color:var(--cyan); background:var(--bg-elev-2); transform:translateX(2px); }
  .option[disabled]{ cursor:default; }
  .option.chosen{ border-color:var(--cyan); background: rgba(0,217,192,.08); }
  .option.chosen .letter{ background:var(--cyan); color:#001612; }
  .option.dimmed{ opacity:.35; }

  .consequence{
    margin-top:16px; padding:16px; border-radius:14px; background:var(--bg-elev-2);
    border-left:3px solid var(--cyan); font-size:14px; line-height:1.55; color:var(--text);
    animation: rise .4s ease; display:none;
  }
  .consequence.show{ display:block; }
  .consequence .pts{ font-family:'JetBrains Mono',monospace; color:var(--amber); font-weight:700; font-size:12.5px; display:block; margin-top:8px; }
  .consequence .flavor{ color:var(--text-dim); font-size:12.5px; margin-top:4px; font-style:italic; }

  .next-wrap{ margin-top:20px; display:none; }
  .next-wrap.show{ display:block; }

  /* ============ RESULT SCREEN ============ */
  #screen-result{ justify-content:flex-start; gap:20px; text-align:center; position:relative; }
  .confetti-canvas{ position:fixed; inset:0; pointer-events:none; z-index:50; }
  .result-eyebrow{ font-family:'JetBrains Mono',monospace; font-size:11.5px; color:var(--text-dim); letter-spacing:.1em; text-transform:uppercase; }
  .result-name{ font-size:15px; color:var(--text-dim); }
  .rank-card{
    background: linear-gradient(160deg, var(--bg-elev-2), var(--bg-elev));
    border:1px solid var(--line); border-radius:22px; padding:28px 20px; position:relative; overflow:hidden;
  }
  .rank-card::after{
    content:""; position:absolute; inset:0; background: radial-gradient(circle at 50% 0%, rgba(255,176,32,.18), transparent 60%);
  }
  .rank-icon{ font-size:44px; margin-bottom:10px; position:relative; }
  .rank-title{ font-size:26px; font-weight:700; font-family:'Space Grotesk',sans-serif; position:relative; background:linear-gradient(135deg,var(--amber),var(--cyan)); -webkit-background-clip:text; background-clip:text; color:transparent;}
  .rank-score{ font-family:'JetBrains Mono',monospace; font-size:13px; color:var(--text-dim); margin-top:8px; position:relative; }
  .rank-score b{ color:var(--text); font-size:15px; }

  .badges-title{ font-size:12px; text-transform:uppercase; letter-spacing:.08em; color:var(--text-dim); margin-top:4px; text-align:left; font-family:'JetBrains Mono',monospace;}
  .badges-grid{ display:grid; grid-template-columns:repeat(5,1fr); gap:8px; }
  .badge{
    aspect-ratio:1; border-radius:14px; background:var(--bg-elev); border:1px solid var(--line);
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4px; font-size:19px;
    opacity:.3; transition: all .5s ease;
  }
  .badge.earned{ opacity:1; border-color:var(--amber); background:rgba(255,176,32,.08); box-shadow:0 0 20px -8px rgba(255,176,32,.6); }
  .badge span{ font-size:8.5px; font-family:'JetBrains Mono',monospace; color:var(--text-dim); text-align:center; line-height:1.2; }

  .persuasion-card{
    background:var(--bg-elev); border:1px solid var(--line); border-radius:16px; padding:20px; text-align:left;
  }
  .persuasion-card p{ font-size:14.5px; line-height:1.6; color:var(--text-dim); }
  .persuasion-card p b{ color:var(--text); }
  .persuasion-card .cta-line{ margin-top:12px; font-size:15px; color:var(--text); font-weight:600; }

  .action-row{ display:flex; gap:10px; }
  .action-row .btn{ flex:1; font-size:14px; padding:14px; }

  footer.legal{ text-align:center; font-size:11px; color:#4a5674; margin-top:auto; padding-top:24px; font-family:'JetBrains Mono',monospace; }

  ::selection{ background:var(--cyan); color:#001612; }
  @media (prefers-reduced-motion: reduce){
    *{ animation-duration:.001ms !important; transition-duration:.001ms !important; }
  }
</style>
</head>
<body>

<div class="app" id="app">

  <!-- ============ SCREEN 0 : HERO ============ -->
  <section class="screen active" id="screen-hero">
    <div class="grid-fx"></div>
    <div style="position:relative; display:flex; flex-direction:column; gap:22px; flex:1; justify-content:center;">
      <div class="eyebrow"><span class="dot"></span> DESAFÍO DE LIDERAZGO · 5 MIN</div>
      <h1 class="hero-title">¿Tienes lo necesario<br>para dirigir <span class="accent">una empresa</span>?</h1>
      <p class="hero-sub">En 5 decisiones vas a enfrentar los mismos problemas que resuelve a diario un profesional de logística. Una empresa completa depende de tus llamadas.</p>
      <div>
        <div class="route-preview">
          <div class="seg"><i></i></div><div class="seg"><i></i></div><div class="seg"><i></i></div><div class="seg"><i></i></div><div class="seg"><i></i></div>
        </div>
        <p class="hero-stat" style="margin-top:8px;">🏆 Todos obtienen un cargo y una insignia al terminar</p>
      </div>
      <button class="btn btn-primary" onclick="goTo('mission')">🚀 Iniciar simulación</button>
    </div>
  </section>

  <!-- ============ SCREEN 1 : MISSION ============ -->
  <section class="screen" id="screen-mission">
    <div class="mission-card">
      <div class="mission-eyebrow">Tu misión</div>
      <h2 class="mission-title">Bienvenido a Andes Cargo</h2>
      <p class="mission-body">Hoy es tu primer día como <b style="color:var(--text)">Encargado de Logística</b>. Ya tienes 5 decisiones críticas en tu escritorio y todas están esperando tu firma. Cada una construye tu perfil de liderazgo — y define el cargo con el que termines hoy.</p>
      <div class="name-field">
        <label for="playerName">¿Cómo quieres que aparezca tu nombre en el resultado?</label>
        <input type="text" id="playerName" placeholder="Escribe tu nombre" maxlength="24">
      </div>
      <div class="meta-row">
        <span>⏱ ~4 min</span>
        <span>📋 5 decisiones</span>
        <span>🎖 Resultado inmediato</span>
      </div>
    </div>
    <div style="margin-top:18px;">
      <button class="btn btn-primary" onclick="acceptMission()">Aceptar el cargo →</button>
    </div>
  </section>

  <!-- ============ SCREENS 2-6 : DECISIONS (templated by JS) ============ -->
  <section class="screen" id="screen-decision">
    <div class="stepper-wrap">
      <div class="stepper-top">
        <span class="stepper-label" id="stepperLabel">Decisión 1 de 5</span>
        <span class="stepper-zeigarnik" id="stepperZeigarnik">Faltan 4 para tu resultado</span>
      </div>
      <div class="stepper-track">
        <div class="stepper-line-bg"></div>
        <div class="stepper-line-fill" id="stepperFill" style="width:0%"></div>
        <div class="stepper-nodes" id="stepperNodes"></div>
      </div>
    </div>

    <div class="decision-tag" id="decisionTag">SITUACIÓN</div>
    <h3 class="decision-title" id="decisionTitle"></h3>
    <p class="decision-scenario" id="decisionScenario"></p>

    <div class="options" id="decisionOptions"></div>
    <div class="consequence" id="decisionConsequence"></div>

    <div class="next-wrap" id="nextWrap">
      <button class="btn btn-primary" id="nextBtn" onclick="nextDecision()">Continuar →</button>
    </div>
  </section>

  <!-- ============ SCREEN 7 : RESULT ============ -->
  <section class="screen" id="screen-result">
    <canvas class="confetti-canvas" id="confettiCanvas"></canvas>
    <div>
      <div class="result-eyebrow">Simulación completada</div>
      <div class="result-name" id="resultName"></div>
    </div>

    <div class="rank-card">
      <div class="rank-icon" id="rankIcon">🏆</div>
      <div class="rank-title" id="rankTitle">Cargo</div>
      <div class="rank-score">Puntaje de liderazgo: <b id="rankScore">0</b> / 75</div>
    </div>

    <div>
      <div class="badges-title">Insignias desbloqueadas</div>
      <div class="badges-grid" id="badgesGrid"></div>
    </div>

    <div class="persuasion-card">
      <p><b id="resultInsight">Acabas de tomar decisiones reales de logística.</b></p>
      <p style="margin-top:8px;">Esto es exactamente lo que resuelve todos los días un profesional de <b>Administración con mención en Logística</b>: rutas, inventario, clientes, calidad y proveedores — bajo presión y con datos incompletos.</p>
      <p class="cta-line">Si te gustó pensar así, esta especialidad es tu lugar. 📦</p>
    </div>

    <div class="action-row">
      <button class="btn btn-ghost" onclick="downloadCertificate()">🎓 Descargar certificado</button>
      <button class="btn btn-primary" onclick="shareResult()">📤 Compartir</button>
    </div>

    <button class="btn btn-ghost" onclick="location.reload()">🔁 Repetir el desafío</button>

    <footer class="legal">ANDES CARGO S.A. · SIMULACIÓN EDUCATIVA</footer>
  </section>

</div>

<script>
/* ============================================================
   DATA — copy final, listo para usar
   ============================================================ */
const DECISIONS = [
  {
    tag: "Decisión 1 de 5 · Ruta",
    title: "El camión que no llega",
    scenario: "Son las 7:40 AM. Un camión con 400 pedidos queda atrapado por un corte de ruta. Tu cliente más importante exige su entrega antes de las 9:00 AM en punto, o cancela el contrato.",
    options: [
      { text: "Dividir la carga en dos camionetas más pequeñas y tomar una ruta alternativa.", pts: 15, badge: "reaccion",
        result: "Decisión inteligente: llegan a las 8:55 AM. El cliente renueva el contrato por 2 años más.", flavor: "Reaccionaste rápido con los recursos que tenías." },
      { text: "Esperar a que se libere la ruta principal.", pts: 5,
        result: "El camión llega a las 9:40 AM. El cliente presenta una queja formal.", flavor: "A veces esperar cuesta más que actuar." },
      { text: "Llamar al cliente y negociar 30 minutos extra a cambio de un descuento.", pts: 10,
        result: "El cliente acepta. Salvas la relación, aunque con un costo para la empresa.", flavor: "Negociar también es una forma de liderar." }
    ]
  },
  {
    tag: "Decisión 2 de 5 · Inventario",
    title: "El stock que se agota",
    scenario: "Es Black Friday. La demanda de tu producto estrella subió 300% y el inventario se agota en 2 horas.",
    options: [
      { text: "Activar al proveedor de respaldo, aunque cueste 12% más.", pts: 15, badge: "stock",
        result: "El stock nunca se corta. El día cierra con ventas récord.", flavor: "Pagaste un poco más para no perder la oportunidad." },
      { text: "Vender lo que queda y abrir preventa para el resto.", pts: 10,
        result: "Mantienes tus márgenes, pero pierdes ventas inmediatas.", flavor: "Una jugada conservadora, pero segura." },
      { text: "No hacer nada y dejar que el producto se agote.", pts: 5,
        result: "El producto queda sin stock 3 días. Varios clientes compran en la competencia.", flavor: "Toda decisión — incluso no decidir — tiene consecuencias." }
    ]
  },
  {
    tag: "Decisión 3 de 5 · Clientes",
    title: "La emergencia inesperada",
    scenario: "Un cliente pequeño, cuyo pedido iba en la cola normal, te llama: necesita su envío hoy mismo por una emergencia médica familiar.",
    options: [
      { text: "Priorizar su pedido y reorganizar la ruta del día para todos.", pts: 15, badge: "cliente",
        result: "El pedido llega a tiempo. El cliente comparte su experiencia en redes sociales.", flavor: "Pusiste a la persona antes que el protocolo." },
      { text: "Mantener el orden de la cola, sin excepciones.", pts: 8,
        result: "Cumples el protocolo al pie de la letra, pero pierdes la oportunidad de fidelizar.", flavor: "Las reglas existen por algo — aunque a veces tengan costo." },
      { text: "Ofrecer un envío urgente pagado como alternativa.", pts: 12,
        result: "El cliente acepta pagar el extra. Resuelves la urgencia y proteges el margen.", flavor: "Encontraste un punto medio razonable." }
    ]
  },
  {
    tag: "Decisión 4 de 5 · Calidad",
    title: "El lote con daños",
    scenario: "En control de calidad descubres que el 8% de un lote está dañado. Enviarlo tal cual cumpliría el plazo prometido.",
    options: [
      { text: "Detener el envío y reemplazar las unidades dañadas.", pts: 15, badge: "calidad",
        result: "Se retrasa 4 horas, pero llega sin un solo reclamo. La confianza del cliente queda intacta.", flavor: "Elegiste calidad por sobre velocidad." },
      { text: "Enviar todo el lote tal como está.", pts: 5,
        result: "Llegas a tiempo, pero recibes devoluciones y una mala reseña pública.", flavor: "El plazo se cumplió, pero al costo de la reputación." },
      { text: "Enviar ahora el 92% en buen estado y el resto después.", pts: 12,
        result: "Buen equilibrio entre plazo y calidad. El cliente queda conforme.", flavor: "Una solución intermedia, práctica y razonable." }
    ]
  },
  {
    tag: "Decisión 5 de 5 · Proveedores",
    title: "El contrato anual",
    scenario: "Debes firmar el contrato de transporte para todo el próximo año. Tienes tres propuestas sobre la mesa.",
    options: [
      { text: "El proveedor más barato, con entregas más lentas.", pts: 8,
        result: "Ahorras costos, pero los tiempos de entrega generan quejas recurrentes.", flavor: "El precio no siempre es la variable más importante." },
      { text: "El proveedor premium: rápido, caro y sin margen de error.", pts: 10,
        result: "Las entregas son impecables, pero el margen de la empresa se reduce.", flavor: "La excelencia también tiene un precio." },
      { text: "El proveedor con mejor relación calidad-precio y trazabilidad en tiempo real.", pts: 15, badge: "estrategia",
        result: "La decisión más equilibrada: velocidad, costo y visibilidad total de cada envío.", flavor: "Pensaste en el sistema completo, no solo en un número." }
    ]
  }
];

const BADGES = [
  { id: "reaccion",  icon: "⚡", label: "Reacción rápida" },
  { id: "stock",     icon: "📦", label: "Visión de stock" },
  { id: "cliente",   icon: "🤝", label: "Foco en cliente" },
  { id: "calidad",   icon: "✅", label: "Control de calidad" },
  { id: "estrategia",icon: "💡", label: "Decisión estratégica" }
];

const RANKS = [
  { min: 0,  title: "Operador Logístico",      icon: "📋" },
  { min: 31, title: "Supervisor Logístico",     icon: "🧭" },
  { min: 46, title: "Coordinador Logístico",    icon: "🛠️" },
  { min: 59, title: "Gerente Logístico",        icon: "🚀" },
  { min: 69, title: "Director de Operaciones",  icon: "🏆" }
];

const AFFIRMATIONS = {
  high: ["Así piensan los líderes.", "Decisión de gerente.", "Exactamente lo que haría un profesional."],
  mid:  ["Jugada razonable.", "Decisión equilibrada.", "Válido — hay más de un buen camino."],
  low:  ["Aprendiste algo clave para la próxima.", "Así se entrena el criterio.", "Cada decisión suma experiencia."]
};

/* ============================================================
   STATE
   ============================================================ */
let currentDecisionIndex = 0;
let score = 0;
let earnedBadges = new Set();
let playerName = "";

/* ============================================================
   NAVIGATION
   ============================================================ */
function goTo(id){
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById('screen-' + id).classList.add('active');
  window.scrollTo(0,0);
}

function acceptMission(){
  const val = document.getElementById('playerName').value.trim();
  playerName = val || "Futuro/a líder";
  goTo('decision');
  renderDecision();
}

/* ============================================================
   STEPPER (route map)
   ============================================================ */
function renderStepper(){
  const nodesWrap = document.getElementById('stepperNodes');
  nodesWrap.innerHTML = '';
  DECISIONS.forEach((_, i) => {
    const n = document.createElement('div');
    n.className = 'node';
    if (i < currentDecisionIndex) { n.classList.add('done'); n.textContent = '✓'; }
    else if (i === currentDecisionIndex) { n.classList.add('current'); n.textContent = i + 1; }
    else { n.textContent = i + 1; }
    nodesWrap.appendChild(n);
  });
  const pct = (currentDecisionIndex / (DECISIONS.length - 1)) * 100;
  document.getElementById('stepperFill').style.width = Math.min(pct, 100) + '%';
  document.getElementById('stepperLabel').textContent = `Decisión ${currentDecisionIndex + 1} de ${DECISIONS.length}`;
  const remaining = DECISIONS.length - currentDecisionIndex - 1;
  document.getElementById('stepperZeigarnik').textContent = remaining > 0
    ? `Faltan ${remaining} para tu resultado`
    : `Última decisión`;
}

/* ============================================================
   RENDER A DECISION SCREEN
   ============================================================ */
function renderDecision(){
  const d = DECISIONS[currentDecisionIndex];
  renderStepper();
  document.getElementById('decisionTag').textContent = d.tag.split('·')[1] ? d.tag.split('·')[1].trim().toUpperCase() : 'SITUACIÓN';
  document.getElementById('decisionTitle').textContent = d.title;
  document.getElementById('decisionScenario').textContent = d.scenario;

  const optWrap = document.getElementById('decisionOptions');
  optWrap.innerHTML = '';
  const letters = ['A','B','C'];
  d.options.forEach((opt, i) => {
    const btn = document.createElement('button');
    btn.className = 'option';
    btn.innerHTML = `<span class="letter">${letters[i]}</span><span>${opt.text}</span>`;
    btn.onclick = () => selectOption(i);
    optWrap.appendChild(btn);
  });

  document.getElementById('decisionConsequence').classList.remove('show');
  document.getElementById('nextWrap').classList.remove('show');
}

function selectOption(i){
  const d = DECISIONS[currentDecisionIndex];
  const opt = d.options[i];
  score += opt.pts;
  if (opt.badge) earnedBadges.add(opt.badge);

  const buttons = document.querySelectorAll('#decisionOptions .option');
  buttons.forEach((b, idx) => {
    b.setAttribute('disabled', 'true');
    if (idx === i) b.classList.add('chosen');
    else b.classList.add('dimmed');
  });

  const tier = opt.pts >= 15 ? 'high' : opt.pts >= 10 ? 'mid' : 'low';
  const pool = AFFIRMATIONS[tier];
  const affirmation = pool[Math.floor(Math.random() * pool.length)];

  const cons = document.getElementById('decisionConsequence');
  cons.innerHTML = `${opt.result}<span class="pts">+${opt.pts} pts de liderazgo · ${affirmation}</span><span class="flavor">${opt.flavor}</span>`;
  cons.classList.add('show');

  document.getElementById('nextWrap').classList.add('show');
  document.getElementById('nextBtn').textContent = currentDecisionIndex === DECISIONS.length - 1 ? 'Ver mi resultado →' : 'Continuar →';
}

function nextDecision(){
  currentDecisionIndex++;
  if (currentDecisionIndex >= DECISIONS.length) {
    showResult();
  } else {
    renderDecision();
  }
}

/* ============================================================
   RESULT
   ============================================================ */
function getRank(s){
  let r = RANKS[0];
  for (const rank of RANKS) { if (s >= rank.min) r = rank; }
  return r;
}

function showResult(){
  goTo('result');
  const rank = getRank(score);

  document.getElementById('resultName').textContent = playerName;
  document.getElementById('rankIcon').textContent = rank.icon;
  document.getElementById('rankTitle').textContent = rank.title;

  const insights = {
    "Operador Logístico": "Tomaste decisiones bajo presión — el primer paso de todo gran gerente.",
    "Supervisor Logístico": "Manejaste bien la presión y priorizaste lo importante.",
    "Coordinador Logístico": "Equilibraste costo, tiempo y calidad como un profesional.",
    "Gerente Logístico": "Tus decisiones fueron rápidas, estratégicas y centradas en las personas.",
    "Director de Operaciones": "Pensaste en el sistema completo — así piensan quienes dirigen operaciones reales."
  };
  document.getElementById('resultInsight').textContent = insights[rank.title];

  // animate score count-up
  const scoreEl = document.getElementById('rankScore');
  let cur = 0;
  const step = Math.max(1, Math.round(score / 30));
  const iv = setInterval(() => {
    cur = Math.min(cur + step, score);
    scoreEl.textContent = cur;
    if (cur >= score) clearInterval(iv);
  }, 16);

  // badges grid
  const grid = document.getElementById('badgesGrid');
  grid.innerHTML = '';
  BADGES.forEach(b => {
    const el = document.createElement('div');
    el.className = 'badge' + (earnedBadges.has(b.id) ? ' earned' : '');
    el.innerHTML = `<div>${b.icon}</div><span>${b.label}</span>`;
    grid.appendChild(el);
  });

  launchConfetti();
}

/* ============================================================
   CONFETTI (lightweight canvas, no dependencies)
   ============================================================ */
function launchConfetti(){
  const canvas = document.getElementById('confettiCanvas');
  const ctx = canvas.getContext('2d');
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
  const colors = ['#00d9c0', '#ffb020', '#7c5cfc', '#eef2fa'];
  const particles = Array.from({length: 90}, () => ({
    x: Math.random() * canvas.width,
    y: -20 - Math.random() * canvas.height * 0.5,
    r: 4 + Math.random() * 5,
    c: colors[Math.floor(Math.random() * colors.length)],
    vy: 2 + Math.random() * 3,
    vx: -1.5 + Math.random() * 3,
    rot: Math.random() * 360,
    vrot: -6 + Math.random() * 12
  }));
  let frame = 0;
  function loop(){
    frame++;
    ctx.clearRect(0,0,canvas.width, canvas.height);
    particles.forEach(p => {
      p.x += p.vx; p.y += p.vy; p.rot += p.vrot;
      ctx.save();
      ctx.translate(p.x, p.y);
      ctx.rotate(p.rot * Math.PI/180);
      ctx.fillStyle = p.c;
      ctx.fillRect(-p.r/2, -p.r/2, p.r, p.r*0.6);
      ctx.restore();
    });
    if (frame < 220) requestAnimationFrame(loop);
    else ctx.clearRect(0,0,canvas.width, canvas.height);
  }
  loop();
}

/* ============================================================
   SHARE
   ============================================================ */
async function shareResult(){
  const rank = getRank(score);
  const text = `Acabo de completar el desafío "¿Tienes lo necesario para dirigir una empresa?" y obtuve el cargo de ${rank.title} con ${score}/75 puntos de liderazgo. 🚀📦`;
  if (navigator.share) {
    try { await navigator.share({ title: 'Mi resultado en Andes Cargo', text }); }
    catch(e) { /* user cancelled */ }
  } else {
    try {
      await navigator.clipboard.writeText(text);
      alert('Resultado copiado. ¡Pégalo donde quieras compartirlo!');
    } catch(e) {
      prompt('Copia tu resultado:', text);
    }
  }
}

/* ============================================================
   CERTIFICATE (canvas → PNG download)
   ============================================================ */
function downloadCertificate(){
  const rank = getRank(score);
  const c = document.createElement('canvas');
  c.width = 1000; c.height = 700;
  const ctx = c.getContext('2d');

  const grad = ctx.createLinearGradient(0,0,1000,700);
  grad.addColorStop(0, '#0a0e1a');
  grad.addColorStop(1, '#131b2e');
  ctx.fillStyle = grad;
  ctx.fillRect(0,0,1000,700);

  ctx.strokeStyle = '#263352';
  ctx.lineWidth = 2;
  ctx.strokeRect(30,30,940,640);
  ctx.strokeStyle = 'rgba(0,217,192,.5)';
  ctx.strokeRect(42,42,916,616);

  ctx.textAlign = 'center';
  ctx.fillStyle = '#00d9c0';
  ctx.font = '600 16px monospace';
  ctx.fillText('ANDES CARGO S.A.  ·  CERTIFICADO DE DESEMPEÑO', 500, 130);

  ctx.fillStyle = '#eef2fa';
  ctx.font = '700 42px sans-serif';
  ctx.fillText(playerName || 'Futuro/a líder', 500, 230);

  ctx.font = '400 18px sans-serif';
  ctx.fillStyle = '#8b96ac';
  ctx.fillText('completó la simulación de liderazgo logístico y obtuvo el cargo de', 500, 280);

  ctx.font = '700 56px sans-serif';
  const g2 = ctx.createLinearGradient(300,0,700,0);
  g2.addColorStop(0, '#ffb020');
  g2.addColorStop(1, '#00d9c0');
  ctx.fillStyle = g2;
  ctx.fillText(rank.title, 500, 370);

  ctx.font = '600 20px monospace';
  ctx.fillStyle = '#eef2fa';
  ctx.fillText(`${score} / 75 puntos de liderazgo`, 500, 430);

  ctx.font = '400 16px sans-serif';
  ctx.fillStyle = '#8b96ac';
  ctx.fillText('Esta es la misma toma de decisiones que enfrenta a diario un profesional de', 500, 500);
  ctx.font = '600 18px sans-serif';
  ctx.fillStyle = '#eef2fa';
  ctx.fillText('Administración con mención en Logística', 500, 530);

  ctx.font = '400 13px monospace';
  ctx.fillStyle = '#4a5674';
  const today = new Date().toLocaleDateString('es-CL', { year:'numeric', month:'long', day:'numeric' });
  ctx.fillText(today, 500, 600);

  const link = document.createElement('a');
  link.download = 'certificado-andes-cargo.png';
  link.href = c.toDataURL('image/png');
  link.click();
}

window.addEventListener('resize', () => {
  const canvas = document.getElementById('confettiCanvas');
  canvas.width = window.innerWidth;
  canvas.height = window.innerHeight;
});
</script>
